{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPT scan engine",
  "type": "object",
  "required": ["id", "version", "description", "requires_verified_target", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string"},
    "requires_verified_target": {"type": "boolean"},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tool", "risk"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "tool": {"enum": ["subfinder", "amass", "dnsx", "httpx", "naabu", "katana", "nuclei", "nmap", "gowitness", "builtin_dns", "builtin_http"]},
          "risk": {"enum": ["passive", "low", "medium", "high"]},
          "needs": {"type": "array", "items": {"type": "string"}},
          "args": {"type": "object"}
        }
      }
    }
  }
}
